{
    "name": "@diia-inhouse/analytics",
    "version": "2.3.90",
    "description": "Analytics utils",
    "license": null,
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-analytics",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "find-circulars": "madge --circular --extensions ts ./"
    },
    "dependencies": {
        "bson": "7.2.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.2.2",
        "@diia-inhouse/diia-logger": "4.7.21",
        "@diia-inhouse/oxc-config": "5.0.0",
        "@diia-inhouse/test": "8.3.40",
        "@diia-inhouse/types": "14.6.1",
        "@diia-inhouse/utils": "6.1.29",
        "@types/bson": "4.2.4",
        "@types/node": "25.6.2",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "glob": "13.0.6",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2004",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "ts-patch": "3.3.0",
        "tsdown": "0.22.0",
        "type-fest": "5.6.0",
        "typescript": "5.9.3",
        "vitest": "4.1.11",
        "vitest-mock-extended": "4.0.0"
    },
    "peerDependencies": {
        "@diia-inhouse/types": ">=13.1.0",
        "@diia-inhouse/utils": ">=6.0.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package",
        "branches": [
            "main"
        ]
    },
    "engines": {
        "node": ">=24"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
